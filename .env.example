# .env.example を .env という名前で写し、自分のキーを入れてください。
# .env は誰にも渡さない・git に入れない（.gitignore 済み）。キーが無くても、見積もりと手で貼る形は全部動きます。

# X API の接続先。空なら公式ドキュメント（https://docs.x.com/x-api/introduction）の接続先を使います。変わったときだけ入れる
X_API_BASE=

# 読むだけ（検索・他の人の投稿）
X_BEARER_TOKEN=

# 自分として投稿する・自分の数字を読む（OAuth 1.0a）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# 自分の X のユーザー名（@ なし）
X_USERNAME=
